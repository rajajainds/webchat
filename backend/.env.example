ENV=dev
DATABASE_URL=postgresql+asyncpg://webchat:webchat@localhost:5432/webchat
MONGO_URL=mongodb://localhost:27017
MONGO_DB=webchat
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173

# OTP emails. Leave everything below empty in dev: the code is always 123456 (printed in the log).
# Option 1: send the mail ourselves through any SMTP server (Gmail app password, Brevo, AWS SES...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Option 2: Twilio Verify (needs a SendGrid account behind it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# auto = Twilio if set, else SMTP if set, else dev. Or force: twilio | email | dev
OTP_PROVIDER=auto
