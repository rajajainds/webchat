ENV=dev
DATABASE_URL=postgresql+asyncpg://webchat:webchat@localhost:5432/webchat
MONGO_URL=mongodb://localhost:27017
MONGO_DB=webchat
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
# Leave Twilio empty in dev: OTP is always 123456 and printed in the log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
