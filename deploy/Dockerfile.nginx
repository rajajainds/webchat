# Web server image: builds the React app, then serves it with Nginx (which also proxies /api and /ws).
# Build context is the repo root, so one command builds everything from this single folder.

# Stage 1: build the React app (Node is only needed here, it is not in the final image)
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: small Nginx image with the built files and our config
FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
